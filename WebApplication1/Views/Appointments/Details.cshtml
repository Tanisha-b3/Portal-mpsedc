@model WebApplication1.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="bi bi-calendar-event"></i> Appointment Details</h4>
                <span class="badge bg-@(Model.Priority switch {
                    AppointmentPriority.Urgent => "danger",
                    AppointmentPriority.High => "warning",
                    AppointmentPriority.Medium => "primary",
                    _ => "secondary"
                }) fs-6">@Model.Priority</span>
            </div>
            <div class="card-body">
                <h3>@Model.Title</h3>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted mb-4">@Model.Description</p>
                }

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong><i class="bi bi-calendar"></i> Start Date</strong>
                        <p>@Model.StartDate.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="bi bi-clock"></i> Time</strong>
                        <p>@Model.StartDate.ToString("hh:mm tt") - @Model.EndDate.ToString("hh:mm tt")</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Location))
                {
                    <div class="mb-3">
                        <strong><i class="bi bi-geo-alt"></i> Location</strong>
                        <p>@Model.Location</p>
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong><i class="bi bi-info-circle"></i> Status</strong>
                        <p>
                            @if (Model.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (Model.IsOngoing)
                            {
                                <span class="badge bg-warning">Ongoing</span>
                            }
                            else if (Model.IsUpcoming)
                            {
                                <span class="badge bg-info">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Past</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="bi bi-clock-history"></i> Created</strong>
                        <p>@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="mb-3">
                        <strong><i class="bi bi-pencil-square"></i> Last Updated</strong>
                        <p>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <div>
                        <form asp-action="ToggleComplete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-@(Model.IsCompleted ? "warning" : "success")">
                                <i class="bi bi-@(Model.IsCompleted ? "arrow-counterclockwise" : "check-circle")"></i>
                                @(Model.IsCompleted ? "Mark Incomplete" : "Mark Complete")
                            </button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
