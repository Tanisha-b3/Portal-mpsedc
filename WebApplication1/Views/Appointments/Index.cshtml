@model List<WebApplication1.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-calendar-event"></i> Appointments</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Appointment
    </a>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total</h6>
                        <h2>@ViewBag.TotalCount</h2>
                    </div>
                    <i class="bi bi-calendar display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Upcoming</h6>
                        <h2>@ViewBag.UpcomingCount</h2>
                    </div>
                    <i class="bi bi-clock display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Completed</h6>
                        <h2>@ViewBag.CompletedCount</h2>
                    </div>
                    <i class="bi bi-check-circle display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Today</h6>
                        <h2>@Model.Count(a => a.StartDate.Date == DateTime.Today)</h2>
                    </div>
                    <i class="bi bi-calendar-day display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search appointments..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="filter" class="form-select">
                    @if (ViewBag.CurrentFilter == "all")
                    {
                        <option value="all" selected>All Appointments</option>
                    }
                    else
                    {
                        <option value="all">All Appointments</option>
                    }
                    @if (ViewBag.CurrentFilter == "upcoming")
                    {
                        <option value="upcoming" selected>Upcoming</option>
                    }
                    else
                    {
                        <option value="upcoming">Upcoming</option>
                    }
                    @if (ViewBag.CurrentFilter == "ongoing")
                    {
                        <option value="ongoing" selected>Ongoing</option>
                    }
                    else
                    {
                        <option value="ongoing">Ongoing</option>
                    }
                    @if (ViewBag.CurrentFilter == "completed")
                    {
                        <option value="completed" selected>Completed</option>
                    }
                    else
                    {
                        <option value="completed">Completed</option>
                    }
                    @if (ViewBag.CurrentFilter == "past")
                    {
                        <option value="past" selected>Past</option>
                    }
                    else
                    {
                        <option value="past">Past</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Appointments List -->
@if (Model.Any())
{
    <div class="row">
        @foreach (var appointment in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 appointment-card @(appointment.IsCompleted ? "border-success" : appointment.IsOngoing ? "border-warning" : "border-primary")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge bg-@(appointment.Priority switch {
                            AppointmentPriority.Urgent => "danger",
                            AppointmentPriority.High => "warning",
                            AppointmentPriority.Medium => "primary",
                            _ => "secondary"
                        })">@appointment.Priority</span>
                        @if (appointment.IsCompleted)
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else if (appointment.IsOngoing)
                        {
                            <span class="badge bg-warning">Ongoing</span>
                        }
                        else if (appointment.IsUpcoming)
                        {
                            <span class="badge bg-info">Upcoming</span>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@appointment.Title</h5>
                        @if (!string.IsNullOrEmpty(appointment.Description))
                        {
                            <p class="card-text text-muted">@appointment.Description</p>
                        }
                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> @appointment.StartDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> @appointment.StartDate.ToString("hh:mm tt") - @appointment.EndDate.ToString("hh:mm tt")
                            </small>
                        </div>
                        @if (!string.IsNullOrEmpty(appointment.Location))
                        {
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @appointment.Location
                                </small>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="ToggleComplete" asp-route-id="@appointment.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-@(appointment.IsCompleted ? "arrow-counterclockwise" : "check")"></i>
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@appointment.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-calendar-x display-1 text-muted"></i>
        <h3 class="mt-3">No Appointments Found</h3>
        <p class="text-muted">
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
            {
                <span>No results for "@ViewBag.SearchQuery". Try a different search.</span>
            }
            else
            {
                <span>You don't have any appointments yet. Create your first one!</span>
            }
        </p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create Appointment
        </a>
    </div>
}
